NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-or-anon-key"
# New Supabase projects may label these as publishable/secret keys instead.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="issue-images"
DATABASE_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres"
CIVIC_ADMIN_EMAIL="admin@yourcity.gov"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org/search"
NOMINATIM_USER_AGENT="CivicReport/1.0 contact@yourdomain.com"
