CIVIC_DB_PATH="./prisma/dev.db"

# Production database. When set, the app uses PostgreSQL instead of the local SQLite fallback.
DATABASE_URL="postgresql://user:password@localhost:5432/civic_report"

# Local/admin bootstrap. Set this before signing in to /login.
CIVIC_ADMIN_EMAIL="admin@yourcity.gov"
CIVIC_ADMIN_PASSWORD="replace-with-a-long-password"

# Resend email delivery
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="CivicReport <updates@yourdomain.com>"

# S3-compatible object storage (AWS S3, Cloudflare R2, Supabase S3, etc.)
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="civic-report-uploads"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_PUBLIC_URL="https://cdn.yourdomain.com"

# Address lookup (the default uses OpenStreetMap Nominatim; configure a compliant provider for production volume)
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org/search"
NOMINATIM_USER_AGENT="CivicReport/1.0 contact@yourdomain.com"
